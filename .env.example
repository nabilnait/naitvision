# Copy to .env for local builds. In Cloudflare Pages set these under Settings > Variables and Secrets.
# Full site URL, used for canonical links, sitemap and Open Graph.
SITE_URL=https://naitvision.be
# Turnstile site key (public). Without it the site uses Cloudflare's test key, which always passes.
PUBLIC_TURNSTILE_SITE_KEY=
# Optional: Cloudflare Web Analytics token. Leave empty if you enable Web Analytics with one click in Pages.
PUBLIC_CF_BEACON_TOKEN=

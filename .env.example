# Copy to .env for local builds. On Cloudflare these are BUILD variables (Worker > Settings > Build).
# Full site URL, used for canonical links, sitemap and Open Graph.
SITE_URL=https://naitvision.be
# Turnstile site key (public). Required in production; without it the contact form is disabled.
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics token (needed on Workers).
PUBLIC_CF_BEACON_TOKEN=

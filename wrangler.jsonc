{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "naitvision",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // the Worker handles /api/* and fills in the Turnstile key on /contact; the rest is served straight from dist
    "run_worker_first": ["/api/*", "/contact", "/contact.html"]
  },
  // Public, non-secret settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY) are set with `wrangler secret put`.
  "vars": {
    "CONTACT_TO": "info@naitvision.be",
    "CONTACT_FROM": "Naitvision website <website@naitvision.be>",
    // public Turnstile site key; the Worker fills it into /contact (the secret key is a wrangler secret)
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF5NPZMXgzf3jK31"
  },
  // Custom domains: listed here so every deploy keeps them (and their DNS records).
  // www.naitvision.be is redirected to naitvision.be by a Redirect Rule in the Cloudflare dashboard.
  "routes": [
    { "pattern": "naitvision.be", "custom_domain": true },
    { "pattern": "www.naitvision.be", "custom_domain": true }
  ],
  // keep variables set in the dashboard when deploying
  "keep_vars": true,
  "observability": { "enabled": true }
}

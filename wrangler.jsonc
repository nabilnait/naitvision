{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "naitvision",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // the Worker handles /api/* and fills in the Turnstile key on /contact; the rest is served straight from dist
    "run_worker_first": ["/api/*", "/contact", "/contact.html"]
  },
  // Public, non-secret settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY) are set with `wrangler secret put`.
  "vars": {
    "CONTACT_TO": "info@naitvision.be",
    "CONTACT_FROM": "Naitvision website <website@naitvision.be>"
    // "TURNSTILE_SITE_KEY": "0x4AAAA..."  optional: the public site key, if you prefer it here over a build variable
  },
  // keep variables set in the dashboard when deploying
  "keep_vars": true,
  "observability": { "enabled": true }
}

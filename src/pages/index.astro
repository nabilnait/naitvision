---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Intro from '../components/Intro.astro';
import Clients from '../components/Clients.astro';
import Impact from '../components/Impact.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { t, clean, present } from '../i18n';
const c = t('nl');
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items
    .filter((i) => present(i.a) && !i.a.includes('[INVULLEN'))
    .map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: clean(i.a) } })),
};
---
<Base schema={faqSchema.mainEntity.length ? [faqSchema] : []}>
  <Hero />
  <section class="band" aria-label="Wat we maken">
    <Marquee items={c.marquee.primary} />
    <Marquee items={c.marquee.secondary} reverse muted speed={55} />
  </section>
  <Intro />
  <Clients />
  <Impact />
  <Process />
  <Services />
  <About />
  <Faq />
  <FinalCta />
</Base>
<style>
  .band { border-block: 1px solid var(--line); padding-block: var(--space-3); }
</style>

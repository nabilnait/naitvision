---
/** A single full-width photo, no text. Wide crop on desktop, taller crop on phones. */
import { Image } from 'astro:assets';
import photo from '../assets/photos/langs-het-veld.jpg';
import { t, type Lang } from '../i18n';
interface Props { lang?: Lang }
const s = t(Astro.props.lang).photo;
const widths = [480, 768, 1080, 1440, 1920].filter((w) => w < photo.width).concat(photo.width);
---
<section class="photo-band" aria-label={s.alt}>
  <div class="container">
    <figure class="photo-band__frame" data-reveal>
      <div class="photo-band__inner" data-parallax="3">
        <Image src={photo} alt={s.alt} widths={widths} sizes="(max-width: 1488px) calc(100vw - 2 * var(--gutter)), 1440px" format="avif" quality={72} loading="lazy" />
      </div>
    </figure>
  </div>
</section>
<style>
  .photo-band { padding-block: calc(var(--section-pad) * .5); }
  .photo-band__frame { position: relative; overflow: hidden; border-radius: var(--radius-sm); aspect-ratio: 3 / 2; max-width: 100%; }
  .photo-band__inner { position: absolute; inset: -4% 0; }
  .photo-band__inner :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 45% 78%; }
  @media (max-width: 760px) {
    .photo-band__frame { aspect-ratio: 4 / 5; }
    .photo-band__inner :global(img) { object-position: 42% 55%; }
  }
</style>

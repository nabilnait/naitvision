---
/** Photo with a short title and text beside it (stacked on phones). */
import { Image } from 'astro:assets';
import Lines from './Lines.astro';
import photo from '../assets/photos/langs-het-veld.jpg';
import { t, type Lang } from '../i18n';
interface Props { lang?: Lang }
const s = t(Astro.props.lang).photo;
const widths = [360, 540, 720, 960].filter((w) => w < photo.width).concat(photo.width);
---
<section class="section photo-band" id={s.id} aria-labelledby={`${s.id}-title`}>
  <div class="container photo-band__grid">
    <figure class="photo-band__frame" data-reveal>
      <div class="photo-band__inner" data-parallax="3">
        <Image src={photo} alt={s.alt} widths={widths} sizes="(max-width: 860px) calc(100vw - 2 * var(--gutter)), min(560px, 42vw)" format="avif" quality={72} loading="lazy" />
      </div>
    </figure>
    <div class="photo-band__text">
      <Lines lines={s.title} id={`${s.id}-title`} />
      {s.text.map((p, i) => <p class="t-lead" data-reveal data-delay={String(0.1 + i * 0.08)}>{p}</p>)}
    </div>
  </div>
</section>
<style>
  .photo-band__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-9); align-items: center; }
  .photo-band__frame { position: relative; overflow: hidden; border-radius: var(--radius-sm); aspect-ratio: 4 / 5; max-width: 560px; width: 100%; }
  .photo-band__inner { position: absolute; inset: -4% 0; }
  .photo-band__inner :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 42% 60%; }
  .photo-band__text { display: grid; gap: var(--space-5); }
  .photo-band__text :global(h2) { margin-bottom: var(--space-3); }
  @media (max-width: 860px) {
    .photo-band__grid { grid-template-columns: 1fr; gap: var(--space-7); }
    .photo-band__frame { max-width: 100%; }
  }
</style>

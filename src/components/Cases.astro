---
import Lines from './Lines.astro';
import Fill from './Fill.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
interface Props { lang?: Lang }
const s = t(Astro.props.lang).cases;
---
<section class="section cases" id={s.id} aria-labelledby={`${s.id}-title`}>
  <div class="container">
    <div class="cases__head">
      <Lines lines={s.title} id={`${s.id}-title`} />
      <a class="btn" href={s.cta.href}>{s.cta.label} <Icon name="arrow" size={16} /></a>
    </div>
    <ol class="case-list" role="list" data-cases>
      {s.items.map((c, i) => (
        <li data-reveal>
          <a class="case" href={`/werk#${c.slug}`} data-preview={c.media ?? ''}>
            <span class="case__num t-label">{String(i + 1).padStart(2, '0')}</span>
            <span class="case__name">{c.name}</span>
            <span class="case__sector">{c.sector}</span>
            <span class="case__delivered muted"><Fill text={c.delivered} /></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="case-preview" aria-hidden="true" data-case-preview>
    <video muted loop playsinline preload="none"></video>
  </div>
</section>
<style>
  .cases__head { display: flex; justify-content: space-between; align-items: end; gap: var(--space-5); flex-wrap: wrap; padding-bottom: var(--space-7); }
  .case-list { margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .case-list > li { border-bottom: 1px solid var(--line); }
  .case {
    display: grid; grid-template-columns: 64px minmax(0, 1.4fr) minmax(0, .8fr) minmax(0, 1fr); gap: var(--space-5); align-items: baseline;
    padding-block: var(--space-6); color: var(--text); text-decoration: none; transition: color .4s var(--ease);
  }
  .case__name { font-family: var(--font-condensed); font-weight: 600; font-size: clamp(1.625rem, 3vw, 2.75rem); line-height: 1.05; text-transform: uppercase; transition: transform .6s var(--ease); }
  .case__sector, .case__delivered { font-size: var(--fs-small); }
  .case-list:hover .case { color: var(--muted); }
  .case-list:hover .case:hover, .case:focus-visible { color: var(--text); }
  .case:hover .case__name { transform: translateX(var(--space-3)); }
  .case-list:hover .case:not(:hover) .case__delivered { color: var(--muted); }
  @media (max-width: 860px) {
    .case { grid-template-columns: 40px minmax(0, 1fr); row-gap: var(--space-2); }
    .case__sector, .case__delivered { grid-column: 2; }
  }
  .case-preview {
    position: fixed; left: 0; top: 0; z-index: 40; width: 200px; aspect-ratio: 9 / 16; border-radius: var(--radius-sm); overflow: hidden;
    pointer-events: none; opacity: 0; transform: translate(-50%, -50%) scale(.9); background: var(--placeholder);
    transition: opacity .35s var(--ease);
  }
  .case-preview.is-on { opacity: 1; }
  .case-preview video { width: 100%; height: 100%; object-fit: cover; }
</style>
<script>
  import { gsap, reduced } from '../scripts/motion';
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const list = document.querySelector<HTMLElement>('[data-cases]');
  const box = document.querySelector<HTMLElement>('[data-case-preview]');
  if (list && box && fine.matches && !reduced) {
    const video = box.querySelector('video')!;
    const xTo = gsap.quickTo(box, 'x', { duration: 0.6, ease: 'power3.out' });
    const yTo = gsap.quickTo(box, 'y', { duration: 0.6, ease: 'power3.out' });
    gsap.set(box, { xPercent: -50, yPercent: -50, scale: 0.9 });
    list.addEventListener('mousemove', (e) => { xTo(e.clientX + 140); yTo(e.clientY); });
    for (const a of list.querySelectorAll<HTMLAnchorElement>('[data-preview]')) {
      a.addEventListener('mouseenter', () => {
        const src = a.dataset.preview;
        if (!src) { box.classList.remove('is-on'); return; }
        if (video.dataset.src !== src) {
          video.dataset.src = src;
          video.poster = `${src}.jpg`;
          video.src = `${src}.mp4`;
        }
        video.play().catch(() => {});
        box.classList.add('is-on');
        gsap.to(box, { scale: 1, duration: 0.5 });
      });
    }
    list.addEventListener('mouseleave', () => { box.classList.remove('is-on'); gsap.to(box, { scale: 0.9, duration: 0.4 }); video.pause(); });
  }
</script>

---
import { Image } from 'astro:assets';
import Lines from './Lines.astro';
import photo from '../assets/team/broers.png';
import { t, type Lang } from '../i18n';
interface Props { lang?: Lang }
const s = t(Astro.props.lang).about;
---
<section class="section about" id={s.id} aria-labelledby={`${s.id}-title`}>
  <div class="container about__grid">
    <figure class="about__photo" data-reveal>
      <Image src={photo} alt={s.photoAlt} widths={[480, 720, 980]} sizes="(max-width: 860px) 100vw, 50vw" format="avif" quality={70} />
    </figure>
    <div class="about__text">
      <Lines lines={s.title} id={`${s.id}-title`} />
      {s.text.map((p, i) => <p class="t-lead" data-reveal data-delay={String(0.1 + i * 0.08)}>{p}</p>)}
    </div>
  </div>
</section>
<style>
  .about__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-8); align-items: center; }
  .about__photo { overflow: hidden; border-radius: var(--radius-sm); }
  .about__photo :global(img) { width: 100%; height: auto; filter: grayscale(1); }
  .about__text { display: grid; gap: var(--space-5); }
  .about__text :global(h2) { margin-bottom: var(--space-3); }
  @media (max-width: 860px) { .about__grid { grid-template-columns: 1fr; gap: var(--space-7); } }
</style>

---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { t, isTodo, isRealHref, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** extra JSON-LD objects for this page */
  schema?: object[];
  noindex?: boolean;
}
const { title, description, lang = 'nl', schema = [], noindex = false } = Astro.props;
const c = t(lang);
const fullTitle = title ? `${title}${c.meta.titleSuffix}` : c.meta.defaultTitle;
const desc = description ?? c.meta.defaultDescription;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const ogImage = new URL(c.meta.ogImage, Astro.site);
const b = c.business;
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: b.name,
  description: c.meta.defaultDescription,
  url: new URL('/', Astro.site).href,
  image: ogImage.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  foundingDate: b.founded,
  areaServed: { '@type': 'AdministrativeArea', name: 'Limburg, België' },
  address: { '@type': 'PostalAddress', addressRegion: 'Limburg', addressCountry: 'BE', ...(isTodo(b.address) || !b.address ? {} : { streetAddress: b.address }) },
  ...(isTodo(b.email) || !b.email ? {} : { email: b.email }),
  ...(isTodo(b.phone) || !b.phone ? {} : { telephone: b.phone }),
  ...(isTodo(b.vat) || !b.vat ? {} : { vatID: b.vat.replace(/[\s.]/g, '') }),
  sameAs: c.socials.map((s) => s.href).filter(isRealHref),
};
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/tomorrow-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.meta.siteName} />
    <meta property="og:locale" content={c.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage.href} />

    <script is:inline>
      document.documentElement.classList.add('js');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reduced');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify([localBusiness, ...schema])} />
  </head>
  <body>
    <a class="skip-link" href="#main">{c.ui.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton lang={lang} />
    <script>
      import '../scripts/main';
    </script>
    {beacon && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })} />
    )}
  </body>
</html>
